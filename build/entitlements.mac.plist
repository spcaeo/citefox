<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT under the hardened runtime. Nothing else is required:
         native addons are re-signed with the app identity, the app is not
         sandboxed, and login-keychain items need no entitlement. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
