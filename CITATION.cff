    website: 'https://www.spaceo.ca'
    email: getcitifox@gmail.com
repository-code: 'https://github.com/spcaeo/citefox'
url: 'https://spcaeo.github.io/citefox/'
license-url: 'https://github.com/spcaeo/citefox/blob/main/LICENSE'
version: 0.12.0
keywords:
  - generative engine optimization
  - answer engine optimization
  - GEO
  - AEO
  - LLM SEO
  - AI Overviews
  - AI search visibility
  - AI citation tracking
