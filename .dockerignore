# scripts/e2e-docker.mjs builds docker/e2e.Dockerfile from the docker/
# directory and never sends the source as build context. This file guards any
# build that uses the repository root as context: secrets and local state stay out.
.secrets
.env
.env.*
**/.env
**/.env.*
**/.claude
.git
node_modules
**/node_modules
out
dist
release
test-results
playwright-report
blob-report
coverage
.playwright
.playwright-mcp
.DS_Store
